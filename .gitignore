# Secrets
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
coverage.xml
htmlcov/

# IDE/editor
.idea/
