*.swp

# Generated market data
backtest/data/

# Stop-width study inputs/outputs (regenerate with backtest/fetch_stopstudy.py)
backtest/data_stopstudy/
backtest/analysis/stop_width_results.parquet

# Generated backtest outputs
backtest/results/
backtest/*.log
backtest/v2/runs/

# Study outputs written to the REPO ROOT, not under backtest/. The pattern above
# only covers backtest/results/, which is why a 111MB equity_curve.csv reached a
# commit and GitHub refused the push (its hard limit is 100MB). All of this is
# regenerable from the scripts in backtest/analysis/ and liquidation_*_test.py,
# so it does not belong in git at any size.
backtest_results/
data_liq/
data_funding/
data_oi/
data_15m/
liq_events*.csv
liq_stress_episodes.csv

# Generated indicator dashboard outputs
indicators/cache/
indicators/history/
indicators/dashboard_snapshot.json
indicators/alert_state.json
# alert_log.jsonl is the permanent alert archive, but it is written by the
# RUNNING service (on the server), not by a developer. It is kept out of git
# and persisted with a Docker volume -- see indicators/Dockerfile.
indicators/alert_log.jsonl
indicators/pending_alerts.json
indicators/alert_outcomes.json

# Local assistant/tool config
.claude/
backtest/analysis/exit_mechanics_results.parquet
